# Supabase Configuration
# DirectHome project: https://xdyrwlseqwggdqhutoop.supabase.co
VITE_SUPABASE_URL=https://xdyrwlseqwggdqhutoop.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Mapbox (required for maps)
VITE_MAPBOX_TOKEN=your_mapbox_access_token

# App Configuration
VITE_APP_NAME=DirectHome
VITE_APP_VERSION=1.0.0

# Google AdSense (optional — leave blank until approved)
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_DEFAULT=
VITE_ADSENSE_SLOT_ESTIMATOR=
VITE_ADSENSE_SLOT_CALCULATOR=

# Flutterwave
# Public key is used in the browser. Secret key is server-only — never prefix with VITE_.
# Live keys: FLWPUBK-… and FLWSECK-…  |  Test keys contain _TEST- in the middle.
# After changing .env locally, restart `npm run dev`. Vercel env vars do not apply on localhost.
VITE_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

# Server-only. Used to save verified tool payments. Supabase → Settings → API.
# Never prefix this with VITE_.
SUPABASE_SERVICE_ROLE_KEY=